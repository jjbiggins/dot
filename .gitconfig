[user]
	email = 39013135+jjbiggins@users.noreply.github.com
	name = Joe Biggins
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	ignorecase = false
	excludesfile = /Users/jjbiggins/.gitignore_global
	precomposeUnicode = true
[pull]
        rebase = true
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[safe]
        directory = /srv/scm/git/repos
[help]
        autocorrect = -1
[sendemail]
	confirm = auto
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
